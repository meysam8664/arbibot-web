# ArbiBot Web configuration. Copy to .env and edit as needed — every value has
# a working default, so the app runs with no .env at all.

# Where market data comes from:
#   auto -> probe the exchange APIs, fall back to the simulator if unreachable
#   live -> only public exchange APIs (no API keys are ever required)
#   sim  -> deterministic simulated feed (offline demos, screenshots, tests)
ARBIBOT_DATA_MODE=auto

# Base assets to scan, compared against every enabled venue.
ARBIBOT_SYMBOLS=BTC,ETH,SOL,XRP,BNB,DOGE,ADA,AVAX,LINK,TON,DOT,LTC
ARBIBOT_QUOTE_CURRENCY=USDT

# Seconds between market polls (minimum 1.0).
ARBIBOT_POLL_INTERVAL=4
# Per-request timeout for exchange REST calls.
ARBIBOT_HTTP_TIMEOUT=8

# Economics used for the net-edge calculation.
# Trade size used for the profit estimate (per leg, in quote currency).
ARBIBOT_NOTIONAL_USD=10000
# Rows below this net edge (after fees and slippage) are not listed. May be
# negative so the dashboard can surface "near miss" spreads.
ARBIBOT_MIN_NET_SPREAD_PCT=0.02
# Flat buffer for queue position / partial fills.
ARBIBOT_SLIPPAGE_BUFFER_PCT=0.02

# Assumed taker fee per venue in percent, e.g.
# ARBIBOT_TAKER_FEES={"binance":0.10,"okx":0.08,"kraken":0.26,"coinbase":0.60}
# Venues to skip entirely:
# ARBIBOT_DISABLED_EXCHANGES=coinbase,htx

# CORS, only needed if the dashboard is served from a different origin.
ARBIBOT_CORS_ORIGINS=*
